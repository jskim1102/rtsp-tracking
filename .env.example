# rtsp-tracking 설정 예시. 설치 스크립트가 이 파일로 .env를 만듭니다.

# ── 포트 ──
# 비워 두면 설치할 때 이 PC에서 사용 가능한 포트를 고릅니다.
BACKEND_PORT=
FRONTEND_PORT=

# ── mediamtx ──
# API 주소는 컨테이너 사이에서 사용합니다. 아래 포트 4개는 설치할 때 채웁니다.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
# 등록한 카메라의 영상 경로와 시청 권한에 사용하는 접두사입니다.
MEDIAMTX_PATH_PREFIX=rtsp_tracking
# 묻기: 다른 PC나 휴대폰에서 영상을 보려면 접속에 쓸 이 PC의 IP 주소를 입력하세요. 여러 개면 쉼표로 구분하고, 이 PC에서만 보면 Enter를 누르세요.
MEDIAMTX_WEBRTC_HOST=
# backend는 제어·송출용, viewer는 시청용입니다. 빈 비밀번호는 설치할 때 각각 생성합니다.
MEDIAMTX_BACKEND_USER=backend
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_tracking
MEDIAMTX_VIEWER_PASS=

# ── 추론 ──
# 실행 중 패키지 자동 설치를 끕니다. 필요한 패키지는 설치할 때 함께 받습니다.
YOLO_AUTOINSTALL=false
# 묻기: 기본 추적기 SAM3를 사용하려면 facebook/sam3 접근이 승인된 Hugging Face 토큰을 입력하세요. YOLO 추적기만 사용하려면 Enter를 누르세요.
HF_TOKEN=
# 기본 추적기입니다. 토큰 없이 시작하려면 yolo-botsort 또는 yolo-bytetrack을 지정하세요.
TRACKER_DEFAULT=sam3
# 비우면 GPU를 자동 감지하고, 없으면 CPU를 사용합니다. 직접 지정할 때는 cuda:0 또는 cpu를 입력하세요.
TRACKER_DEVICE=
# SAM3가 추적할 대상을 설명하는 단어입니다.
TRACKER_CONCEPT_PROMPT=person
# 새 추적 ID를 확정하는 데 필요한 프레임 수입니다.
TRACK_CONFIRM_FRAMES=3
# Hugging Face에서 받을 SAM3 체크포인트입니다.
TRACKER_CHECKPOINT=facebook/sam3
# 추론 입력 크기(픽셀)와 SAM3 GPU 반정밀도 사용 여부입니다.
TRACKER_INPUT_SIZE=560
TRACKER_FP16=true
# SAM3가 기억할 프레임 수, 재조건화 간격(프레임), 보관할 영상 특징 수입니다.
TRACKER_MEMORY_BANK_SIZE=7
TRACKER_RECONDITION_EVERY_NTH_FRAME=16
TRACKER_MAX_VISION_FEATURES_CACHE_SIZE=1

# ── 카메라와 갤러리 ──
# 등록 가능한 카메라의 최대 대수입니다(기본 16, 허용 범위 1~64).
MAX_IPCAMS=16
# 첫 등장 이미지를 저장할 폴더(빈칸은 임시 폴더)와 갤러리의 최대 항목 수입니다.
TRACK_GALLERY_DIR=
TRACK_GALLERY_MAX_ITEMS=500
