# 선택 사항입니다. ./dev.sh는 루트 .env를 읽고 이 프로그램의 MediaMTX에 연결합니다.
# 개발용 백엔드 설정을 바꾸려면 이 파일을 backend/.env로 복사하세요.

# 허용할 프런트엔드 주소입니다. 기본값 *는 모든 주소를 허용합니다.
CORS_ORIGINS=*

# 등록할 수 있는 카메라의 최대 대수입니다 (1~64, 기본 16).
MAX_IPCAMS=16

# 이 프로그램의 MediaMTX에 등록하는 카메라 경로의 접두사와 제어용 계정입니다.
MEDIAMTX_PATH_PREFIX=rtsp_tracking
MEDIAMTX_BACKEND_USER=backend

# 공식 YOLO 모델 저장 폴더입니다. 비우면 backend/models이며 상대 경로는 backend 기준입니다.
YOLO_WEIGHTS_DIR=

# YOLO 추적기(yolo-botsort · yolo-bytetrack)의 검출 신뢰도 기준(0~1)입니다.
DETECTOR_CONF=0.5

# 추적을 기다리는 프레임을 둘 수 있는 카메라 수의 상한입니다 (1~64, 기본 64). 넘치면 가장 먼저 들어온 카메라의 대기 프레임을 버립니다.
TRACKER_PENDING_SOURCES_MAX=64

# 백엔드 로그 수준입니다.
LOG_LEVEL=INFO
